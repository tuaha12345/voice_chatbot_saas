# FastAPI
DATABASE_URL=mysql+pymysql://root@localhost:3306/voice_chat
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080
API_PUBLIC_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000
INTERNAL_AGENT_SECRET=change-me-internal-agent-secret

# LiveKit Cloud (voice will be disabled if empty)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OpenAI (Realtime voice)
OPENAI_API_KEY=
# Admin key for actual billing (platform.openai.com → Settings → Admin keys)
OPENAI_ADMIN_API_KEY=
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
# Estimated USD per 1M tokens (edit to match current OpenAI pricing)
OPENAI_PRICE_INPUT_PER_1M=5
OPENAI_PRICE_OUTPUT_PER_1M=20
OPENAI_PRICE_AUDIO_INPUT_PER_1M=100
OPENAI_PRICE_AUDIO_OUTPUT_PER_1M=200

# Agent worker
API_BASE_URL=http://localhost:8000
AGENT_NAME=voice-qa

# Next.js dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional email (empty = skip, no crash)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# New accounts monthly voice cap
DEFAULT_PLAN_MINUTES=120

# Platform admin (auto-created on API startup when set)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
